{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framecraft",
  "version": "0.1.0",
  "identifier": "com.framecraft.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1427",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Framecraft",
        "width": 1440,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 720,
        "backgroundColor": "#f5f5f0"
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
